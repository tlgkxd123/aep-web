# Writes a C++ source holding a file's bytes as `const unsigned char NAME[]` (NUL-terminated) and `const size_t
# NAME_SIZE`, in namespace aep. Run as: cmake -DINPUT=file -DOUTPUT=file.cpp -DNAME=symbol -P embed.cmake
file(READ "${INPUT}" HEX HEX)
string(LENGTH "${HEX}" HEX_LENGTH)
math(EXPR SIZE "${HEX_LENGTH} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")
file(WRITE "${OUTPUT}" "/** Generated by native/cmake/embed.cmake from ${INPUT}; do not edit. */\n#include <cstddef>\nnamespace aep\n{\nextern const unsigned char ${NAME}[];\nextern const size_t ${NAME}Size;\nconst unsigned char ${NAME}[] = {\n${BYTES}0x00\n};\nconst size_t ${NAME}Size = ${SIZE};\n}\n")
