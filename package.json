{
  "name": "aep-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/build/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && vite build --config vite.desktop.config.ts",
    "dist:desktop": "npm run build:desktop && electron-builder --win",
    "desktop": "npm run build:desktop && electron .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && vite build",
    "test": "vitest run",
    "corpus": "node scripts/corpus-report.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "fflate": "^0.8.3",
    "h264-mp4-encoder": "^1.0.12",
    "mp4-muxer": "^5.2.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
